# Enterprise Knowledge Cycle Platform — 環境変数サンプル
# 実際の値は .env にコピーして設定する。.env は git 管理対象外。

# --- API ---
PORT=8210
DATABASE_URL=postgres://ekcp:ekcp@localhost:15544/ekcp
JWT_SECRET=change-me-in-real-environments
CORS_ORIGINS=http://localhost:3210

# AI構造化を実LLM(Anthropic Claude)で行う場合のみ設定する。
# 未設定の場合はルールベース抽出エンジンにフォールドバックし、MVPは秘密情報なしで動作する。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8210

# --- Postgres (docker-compose) ---
POSTGRES_USER=ekcp
POSTGRES_PASSWORD=ekcp
POSTGRES_DB=ekcp
EKCP_PG_HOST_PORT=15544
EKCP_API_HOST_PORT=8210
EKCP_WEB_HOST_PORT=3210
